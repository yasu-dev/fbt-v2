                <mxCell id="ecs-task" value="ECS Task (1個固定)&lt;br&gt;&lt;b&gt;Next.js Container&lt;/b&gt;&lt;br&gt;&lt;br&gt;- vCPU: 0.25&lt;br&gt;- メモリ: 0.5 GB&lt;br&gt;- イメージ: ECR&lt;br&gt;- ポート: 3000&lt;br&gt;- 機能:&lt;br&gt;  • SSR/ISR (React UI)&lt;br&gt;  • API Routes (107本)&lt;br&gt;  • Socket.io Server&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;月額: $18 (¥2,700)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.ecs_task;" parent="ecs-cluster" vertex="1">
                    <mxGeometry x="91" y="30" width="78" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="rds-proxy" value="RDS Proxy&lt;br&gt;&lt;b&gt;Connection Pooling&lt;/b&gt;&lt;br&gt;&lt;br&gt;- エンドポイント: 1個&lt;br&gt;- ターゲット: Aurora Writer&lt;br&gt;- 接続プール: 50&lt;br&gt;- アイドルタイムアウト: 30分&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;月額: $11 (¥1,650)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.rds_proxy;" parent="private-subnet-a" vertex="1">
