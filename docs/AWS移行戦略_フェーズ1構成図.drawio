                <mxCell id="s3" value="S3 Bucket&lt;br&gt;&lt;b&gt;Static Assets&lt;/b&gt;&lt;br&gt;&lt;br&gt;- バケット名: fbt-assets&lt;br&gt;- ストレージ: 20 GB&lt;br&gt;- ストレージクラス: Standard&lt;br&gt;- バージョニング: 無効&lt;br&gt;- 暗号化: 無効&lt;br&gt;- CDN: なし (直接アクセス)&lt;br&gt;- ライフサイクル:&lt;br&gt;  90日後 Glacier 移行&lt;br&gt;- 用途:&lt;br&gt;  • 商品画像&lt;br&gt;  • PDF帳票&lt;br&gt;  • 動画記録&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;月額: $2 (¥300)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.bucket;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="340" width="75" height="78" as="geometry"/>
