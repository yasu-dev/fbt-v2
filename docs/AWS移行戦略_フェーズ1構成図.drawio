                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="secrets" value="Secrets Manager&lt;br&gt;&lt;b&gt;Credentials&lt;/b&gt;&lt;br&gt;&lt;br&gt;- シークレット数: 2&lt;br&gt;  • DB認証情報&lt;br&gt;  • JWT Secret&lt;br&gt;- ローテーション: なし&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;月額: $0.8 (¥120)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.secrets_manager;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="620" width="75" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="edge10" value="Get Secret" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#DD344C;dashed=1;" parent="1" source="ecs-task" target="secrets" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cloudwatch" value="CloudWatch Logs&lt;br&gt;&lt;b&gt;Logging&lt;/b&gt;&lt;br&gt;&lt;br&gt;- ロググループ:&lt;br&gt;  • /ecs/fbt-v2&lt;br&gt;- 保持期間: 7日&lt;br&gt;- ログ量: 2 GB/月&lt;br&gt;- Alarms: なし&lt;br&gt;- Metrics: なし&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;月額: $1 (¥150)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#F34482;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.cloudwatch;" parent="1" vertex="1">
                    <mxGeometry x="70" y="620" width="75" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="edge11" value="Logs Stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#F34482;dashed=1;" parent="1" source="ecs-task" target="cloudwatch" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cost-summary" value="&lt;b&gt;フェーズ1 月額コスト概算&lt;/b&gt;&lt;br&gt;&lt;br&gt;Compute (ECS Fargate): ¥2,700&lt;br&gt;Network (ALB): ¥2,700&lt;br&gt;Database (Aurora): ¥6,600&lt;br&gt;Cache (Redis): ¥1,500&lt;br&gt;Connection Pool (RDS Proxy): ¥1,650&lt;br&gt;Storage (S3): ¥300&lt;br&gt;Container (ECR): ¥75&lt;br&gt;DNS (Route 53): ¥150&lt;br&gt;Secrets: ¥120&lt;br&gt;Logging (CloudWatch): ¥150&lt;br&gt;Network (NAT): ¥150&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#FF0000&quot;&gt;&lt;b&gt;合計: ¥16,095/月 ($107/月)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;対象: セラー10名、物流50件/日&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#FFB300;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="210" y="830" width="750" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="network-zone" value="&lt;b&gt;ネットワーク構成&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Single-AZ構成（コスト削減）&lt;br&gt;• Public Subnet: ALB, NAT Gateway&lt;br&gt;• Private Subnet: ECS, RDS, Redis&lt;br&gt;• インターネットゲートウェイ: 1個&lt;br&gt;• NAT Gateway: 1個（Outbound用）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="70" y="830" width="120" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="key-features" value="&lt;b&gt;フェーズ1の特徴&lt;/b&gt;&lt;br&gt;&lt;br&gt;✓ 固定1タスク（オートスケールなし）&lt;br&gt;✓ Single-AZ構成&lt;br&gt;✓ CDNなし（S3直接アクセス）&lt;br&gt;✓ 監視最小限（Logsのみ）&lt;br&gt;✓ バックアップ1日保持&lt;br&gt;✓ Aurora MySQL（エンジニア習熟度優先）&lt;br&gt;&lt;br&gt;⚠ 削減できない必須要素:&lt;br&gt;• RDS Proxy（接続プーリング）&lt;br&gt;• Redis（Socket.io Adapter）&lt;br&gt;• Aurora Serverless（Prisma互換）&lt;br&gt;&lt;br&gt;💡 DB選定:&lt;br&gt;PrismaはPostgreSQL/MySQL両対応。&lt;br&gt;担当エンジニアのMySQL習熟度を&lt;br&gt;優先してAurora MySQL 8.0を採用。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="980" y="830" width="270" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="title" value="AWS移行戦略 - フェーズ1: MVP構成図" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1976D2;" parent="1" vertex="1">
                    <mxGeometry x="320" y="10" width="530" height="30" as="geometry"/>
                </mxCell>
