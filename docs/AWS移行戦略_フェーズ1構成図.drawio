                <mxCell id="redis" value="ElastiCache Redis&lt;br&gt;&lt;b&gt;Single-AZ&lt;/b&gt;&lt;br&gt;&lt;br&gt;- ノードタイプ: cache.t4g.micro&lt;br&gt;- ノード数: 1&lt;br&gt;- Redis バージョン: 7.x&lt;br&gt;- 用途:&lt;br&gt;  • セッション管理&lt;br&gt;  • マスタデータキャッシュ&lt;br&gt;  • Socket.io Adapter&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;月額: $10 (¥1,500)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.elasticache_for_redis;" parent="private-subnet-a" vertex="1">
                    <mxGeometry x="491" y="50" width="78" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="aurora" value="Aurora MySQL&lt;br&gt;&lt;b&gt;Serverless v2 (Single-AZ)&lt;/b&gt;&lt;br&gt;&lt;br&gt;- ACU: 0.5 固定&lt;br&gt;- エンジン: MySQL 8.0&lt;br&gt;- ストレージ: 10 GB&lt;br&gt;- バックアップ: 1日保持&lt;br&gt;- Multi-AZ: 無効&lt;br&gt;- 暗号化: 無効&lt;br&gt;- PITR: 有効&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot;&gt;※担当エンジニアのMySQL&lt;br&gt;習熟度を優先して選定&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;月額: $44 (¥6,600)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.aurora_instance;" parent="private-subnet-a" vertex="1">
