                <mxCell id="edge8" value="S3 API&lt;br&gt;Upload/Download" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#7AA116;" parent="1" source="ecs-task" target="s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ecr" value="ECR&lt;br&gt;&lt;b&gt;Container Registry&lt;/b&gt;&lt;br&gt;&lt;br&gt;- リポジトリ: fbt-v2&lt;br&gt;- イメージサイズ: 5 GB&lt;br&gt;- タグ保持: 10個&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;月額: $0.5 (¥75)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.ecr_registry;" parent="1" vertex="1">
